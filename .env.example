# Bot token from BotFather
BOT_TOKEN=
# List of admins user_id for admin access
ADMIN_LIST_ID=
# localisation param, example 'ru'
LANGUAGE=
# Seconds for delay every request
THROTTLING=

# Binance API credentials
BINANCE_API_KEY=
BINANCE_API_SECRET=

# SQLite database path (optional, default: bot/db/database.db)
DB_PATH=

# Binance WS alerts settings
BINANCE_WS_STREAM_URL=wss://fstream.binance.com/stream
BINANCE_WS_POOL_SIZE=5
BINANCE_WS_RECONNECT_DELAY_MS=5000
BINANCE_ALERT_WINDOW_SIZE=15m
BINANCE_ALERT_CACHE_TTL_SECONDS=960
BINANCE_ALERT_SUBSCRIPTIONS_REFRESH_SECONDS=15
BINANCE_ALERT_SYMBOLS_REFRESH_SECONDS=300
BINANCE_ALERT_RECONNECT_DELAY_SECONDS=5
BINANCE_ALERT_WS_IDLE_TIMEOUT_SECONDS=180
BINANCE_ALERT_SUBSCRIBE_DELAY_SECONDS=0.0
BINANCE_ALERT_SUBSCRIBE_CONCURRENCY=8
BINANCE_ALERT_QUEUE_MAXSIZE=5000
BINANCE_ALERT_WORKERS_COUNT=4
BINANCE_ALERT_SEND_CONCURRENCY=8


PROXY_URL=